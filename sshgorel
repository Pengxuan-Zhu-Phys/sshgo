#!/usr/bin/env bash
# Build a Debian package and publish it as a GitHub release.
# ./sshgorel X.Y.Z --branch EXISTING [--dry]
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
usage() {
  cat <<'HELP'
Usage: ./sshgorel X.Y.Z --branch EXISTING [--dry]

  --branch EXISTING  Existing remote branch to update; required to publish.
  --dry              Validate release inputs without modifying files or publishing.

Without --dry, update the version and release notes, build the .deb, commit
release metadata at the current commit, push to the named existing branch and
tag, and publish the .deb
as a GitHub release asset. No Python package is uploaded to PyPI.
Requirements: python3, git, gh, GitHub authentication, and a clean worktree.
HELP
}
if [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]]; then usage; exit 0; fi
if [[ $# -lt 1 ]]; then usage >&2; exit 2; fi
version="$1"
shift
if [[ ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo '[sshgorel] Version must have the form X.Y.Z.' >&2; exit 2
fi
dry=0
branch=''
while (( $# )); do
  case "$1" in
    --dry) dry=1; shift ;;
    --branch)
      (( $# >= 2 )) && [[ -n "$2" && -z "$branch" ]] || { usage >&2; exit 2; }
      branch="$2"; shift 2 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if (( ! dry )) && [[ -z "$branch" ]]; then
  echo '[sshgorel] Specify an existing remote branch with --branch.' >&2; exit 2
fi
cd "$root"
for tool in python3 git; do command -v "$tool" >/dev/null || { echo "[sshgorel] Missing: $tool" >&2; exit 1; }; done
python3 - "$version" <<'PY'
from pathlib import Path
import re, sys
version = sys.argv[1]
control = Path('debian/control').read_text()
found = re.findall(r'(?m)^Version:\s*(\S+)\s*$', control)
if len(found) != 1: raise SystemExit('[sshgorel] Expected exactly one Debian Version field.')
if not re.fullmatch(r'(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)', found[0]):
    raise SystemExit('[sshgorel] Invalid current version.')
if tuple(map(int,version.split('.'))) < tuple(map(int,found[0].split('.'))):
    raise SystemExit('[sshgorel] Target version is older than the current version.')
notes = Path('CHANGELOG.md').read_text()
if not re.search(rf'(?m)^## (?:Unreleased|v?{re.escape(version)}(?:\s|$))', notes):
    raise SystemExit('[sshgorel] Add an Unreleased or matching version section to CHANGELOG.md.')
for name in ('src/sshgo','src/sshgo.zsh','src/sshgo-askpass','scripts/build-deb.sh','README.md'):
    if not Path(name).is_file(): raise SystemExit(f'[sshgorel] Missing {name}')
print(f'[sshgorel] Current: {found[0]}; target: {version}')
PY
if (( dry )); then
  echo '[sshgorel] Static checks passed; no files changed and nothing published.'
  exit 0
fi
command -v gh >/dev/null || { echo '[sshgorel] Missing: gh' >&2; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null
git check-ref-format --branch "$branch" >/dev/null || { echo '[sshgorel] Invalid branch name.' >&2; exit 1; }
current_branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [[ -n "$current_branch" && "$current_branch" != "$branch" ]]; then
  echo "[sshgorel] Current branch $current_branch differs from requested $branch." >&2; exit 1
fi
[[ -z "$(git status --porcelain --untracked-files=normal)" ]] || { echo '[sshgorel] Commit or remove working-tree changes first.' >&2; git status --short >&2; exit 1; }
remote="$(git remote | head -n 1)"
[[ -n "$remote" ]] || { echo '[sshgorel] No Git remote configured.' >&2; exit 1; }
remote_line="$(git ls-remote --heads "$remote" "refs/heads/$branch")"
[[ -n "$remote_line" ]] || { echo "[sshgorel] Remote branch does not exist: $branch" >&2; exit 1; }
remote_head="${remote_line%%[[:space:]]*}"
[[ "$remote_head" == "$(git rev-parse HEAD)" ]] || { echo '[sshgorel] Current commit must match the remote branch before release.' >&2; exit 1; }
tag="v$version"
if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null || [[ -n "$(git ls-remote --tags "$remote" "refs/tags/$tag")" ]]; then
  echo "[sshgorel] Tag already exists: $tag" >&2; exit 1
fi
gh auth status >/dev/null
repo="$(gh repo view "$(git remote get-url --push "$remote")" --json nameWithOwner --jq .nameWithOwner)"
[[ -n "$repo" ]] || { echo '[sshgorel] Could not identify the GitHub repository.' >&2; exit 1; }
if gh release view "$tag" --repo "$repo" >/dev/null 2>&1; then echo "[sshgorel] Release already exists: $tag" >&2; exit 1; fi
python3 - "$version" <<'PY'
from datetime import date
from pathlib import Path
import re, sys
v = sys.argv[1]
p = Path('debian/control'); text = p.read_text()
p.write_text(re.sub(r'(?m)^Version:\s*\S+\s*$', f'Version: {v}', text, count=1))
p = Path('README.md'); text = p.read_text()
p.write_text(re.sub(r'sshgo_\d+\.\d+\.\d+_all\.deb', f'sshgo_{v}_all.deb', text))
p = Path('CHANGELOG.md'); text = p.read_text()
if not re.search(rf'(?m)^## v?{re.escape(v)}(?:\s|$)', text):
    text, count = re.subn(r'(?mi)^## Unreleased\s*$', f'## {v} — {date.today().isoformat()}', text, count=1)
    if count != 1: raise SystemExit('[sshgorel] Cannot prepare release notes.')
    p.write_text(text)
PY
./scripts/build-deb.sh
artifact="dist/sshgo_${version}_all.deb"
[[ -s "$artifact" ]] || { echo '[sshgorel] Package missing.' >&2; exit 1; }
notes="$(mktemp)"
trap 'rm -f "$notes"' EXIT
python3 - "$version" "$notes" <<'PY'
from pathlib import Path
import re, sys
v, dest = sys.argv[1:]
text = Path('CHANGELOG.md').read_text()
m = re.search(rf'(?m)^## v?{re.escape(v)}(?:\s|$).*$', text)
if not m: raise SystemExit('[sshgorel] Missing release notes.')
nxt = re.search(r'(?m)^##\s+', text[m.end():])
body = text[m.end():m.end()+nxt.start() if nxt else None].strip()
if not body: raise SystemExit('[sshgorel] Release notes are empty.')
Path(dest).write_text(body+'\n')
PY
git add -- debian/control README.md CHANGELOG.md
if ! git diff --cached --quiet; then git commit -m "Release $tag"; fi
git tag -a "$tag" -m "sshgo $tag"
git push "$remote" "HEAD:refs/heads/$branch"
git push "$remote" "refs/tags/$tag"
gh release create "$tag" "$artifact" --repo "$repo" --verify-tag --title "sshgo $tag" --notes-file "$notes"
echo "[sshgorel] Published sshgo $version to GitHub Releases."
